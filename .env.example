# Pick an LLM integration when its adapter is enabled.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional integrations. Leave empty until configured.
MEM0_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=

# Public-panel origin permitted to call this API after backend deployment.
KD_AGENT_ALLOWED_ORIGIN=https://projectbykd-jpg.github.io

# Connector activation is explicit. Set only after reviewing each integration.
KD_AGENT_ENABLE_HERMES_AGENT=false
KD_AGENT_ENABLE_OPENSPEC=false
KD_AGENT_ENABLE_SPEC_KIT=false
KD_AGENT_ENABLE_DOCLING=false
KD_AGENT_ENABLE_SCRAPLING=false
KD_AGENT_ENABLE_PAGEINDEX=false
KD_AGENT_ENABLE_MEM0=false
KD_AGENT_ENABLE_HEADROOM=false
KD_AGENT_ENABLE_CAVEMAN=false
KD_AGENT_ENABLE_FABRIC=false
KD_AGENT_ENABLE_DAYTONA=false
KD_AGENT_ENABLE_TRENDRADAR=false
KD_AGENT_ENABLE_HYPERFRAMES=false
KD_AGENT_ENABLE_OPENMONTAGE=false
KD_AGENT_ENABLE_AI_ENGINEERING_HUB=false
